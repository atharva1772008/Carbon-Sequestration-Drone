# ─────────────────────────────────────────────
#  Raspberry Pi Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# URL of the backend server
# Development  → http://localhost:3001
# Production   → https://your-backend.onrender.com
API_URL=http://localhost:3001

# Secret key — must match DEVICE_SECRET in the backend .env
DEVICE_SECRET=change-this-to-a-strong-secret-key

# Unique ID for this specific tree being monitored
TREE_ID=TREE-001

# How many seconds to wait between each reading
SEND_INTERVAL_SECONDS=10

# How many times to retry a failed request before giving up
MAX_RETRIES=3
