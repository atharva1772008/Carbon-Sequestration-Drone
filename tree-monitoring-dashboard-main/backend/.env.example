# ─────────────────────────────────────────────
#  Backend Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to Git
# ─────────────────────────────────────────────

# Port the server will listen on
PORT=3001

# MongoDB connection string
# Local development  → mongodb://localhost:27017/tree-monitor
# MongoDB Atlas      → mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tree-monitor
MONGO_URI=mongodb://localhost:27017/tree-monitor

# Secret key shared with the Raspberry Pi
# The Pi must send this in the X-Secret-Key header for every POST request
# Change this to a long, random string before deploying
DEVICE_SECRET=change-this-to-a-strong-secret-key

# Frontend URL (used for CORS — which origins are allowed to call this API)
# Development  → http://localhost:5173
# Production   → https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173
